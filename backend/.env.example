# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1

# ── AI provider ──────────────────────────────────────────────────────────────
# Any OpenAI-compatible Chat Completions provider can be used.
AI_API_KEY=your_ai_provider_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. your Netlify URL in prod)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3001
