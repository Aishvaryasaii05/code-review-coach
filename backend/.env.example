# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1

# ── IBM Bob Shell ────────────────────────────────────────────────────────────

# Inference-scoped key from https://bob.ibm.com/admin/apikeys
BOB_API_KEY=your_inference_api_key_here
# Optional: required only for General-scoped keys
# BOB_TEAM_ID=your_team_id

# Optional: override the Bob Shell command or workspace directory
# BOB_CLI_PATH=bob
# BOB_WORKSPACE=..

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. your Netlify URL in prod)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3001
